<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>papat for Lightroom Classic</title>
  <organization>app.papat</organization>

  <!-- Current user's home only: no administrator password, no volume/destination choice. -->
  <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="false"/>
  <options customize="never" require-scripts="false"/>

  <welcome file="welcome.html" mime-type="text/html"/>
  <license file="license.html" mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>

  <pkg-ref id="app.papat.lightroom.pkg"/>

  <choices-outline>
    <line choice="default">
      <line choice="app.papat.lightroom.pkg"/>
    </line>
  </choices-outline>

  <choice id="default"/>
  <choice id="app.papat.lightroom.pkg" visible="false">
    <pkg-ref id="app.papat.lightroom.pkg"/>
  </choice>

  <pkg-ref id="app.papat.lightroom.pkg" version="@VERSION@" onConclusion="none">component.pkg</pkg-ref>
</installer-gui-script>
